 /usr/local/libexec/maxiems-deploy-helper runtime-config managed, \
 /usr/local/libexec/maxiems-deploy-helper runtime-config preserve, \
 /usr/local/libexec/maxiems-deploy-helper bms-setup real, \
 /usr/local/libexec/maxiems-deploy-helper bms-setup demo, \
 /usr/local/libexec/maxiems-deploy-helper bms-ready, \
 /usr/local/libexec/maxiems-deploy-helper reboot, \
 /usr/local/libexec/maxiems-deploy-helper bootstrap-status, \
 /usr/local/libexec/maxiems-deploy-helper current-release, \
 /usr/local/libexec/maxiems-deploy-helper bootstrap-config *, \
 /usr/local/libexec/maxiems-deploy-helper begin *, \
 /usr/local/libexec/maxiems-deploy-helper quiesce-legacy *, \
 /usr/local/libexec/maxiems-deploy-helper stage *, \
 /usr/local/libexec/maxiems-deploy-helper activate *, \
 /usr/local/libexec/maxiems-deploy-helper commit *, \
