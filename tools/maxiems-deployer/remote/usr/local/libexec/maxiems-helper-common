#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC2034 # Consumed by the separately checked deploy implementation.
readonly MAXIEMS_ROOT='/opt/maxiems'
readonly MAXIEMS_RELEASES='/opt/maxiems/releases'
# shellcheck disable=SC2034 # Consumed by the separately checked deploy implementation.
readonly MAXIEMS_INCOMING='/var/lib/maxiems-deploy/incoming'
# shellcheck disable=SC2034 # Reserved fixed path for lifecycle state.
readonly MAXIEMS_STATE='/var/lib/maxiems/state'
# shellcheck disable=SC2034 # Consumed by the separately checked deploy implementation.
readonly MAXIEMS_DEPLOY_STATE='/var/lib/maxiems/state/deployments'
# shellcheck disable=SC2034 # Consumed by the separately checked deploy implementation.
readonly MAXIEMS_DEPLOY_LOCK='/run/maxiems-deploy-transaction'
# shellcheck disable=SC2034 # Consumed by the separately checked network implementation.
readonly MAXIEMS_NETWORK_STATE='/var/lib/maxiems/network-transactions'
# shellcheck disable=SC2034 # Consumed by the separately checked network implementation.
readonly MAXIEMS_NETWORK_STAGING='/var/lib/maxiems/shared/network-staging'

die() {
	/usr/bin/printf 'maxiems-helper: %s\n' "$1" >&2
	exit 64
}

require_root() {
	[[ "$(/usr/bin/id -u)" == '0' ]] || die 'root privileges are required'
}

require_arg_count() {
	local expected="$1"
	local actual="$2"
	[[ "$actual" == "$expected" ]] || die 'invalid argument count'
}

validate_release_id() {
	[[ "$1" =~ ^[0-9]{14}-[0-9a-f]{12}$ ]] || die 'invalid release id'
}

validate_sha256() {
	[[ "$1" =~ ^[0-9a-f]{64}$ ]] || die 'invalid sha256'
}

validate_upload_token() {
	[[ "$1" =~ ^\.upload-[0-9a-f]{32}$ ]] || die 'invalid upload token'
}

validate_uuid() {
	[[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] \
		|| die 'invalid transaction id'
}

validate_interface() {
	[[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,14}$ ]] || die 'invalid interface name'
}

require_regular_no_symlink() {
	[[ -f "$1" && ! -L "$1" ]] || die 'required regular file is missing or unsafe'
}

require_root_owned() {
	[[ "$(/usr/bin/stat --format='%u:%g' -- "$1")" == '0:0' ]] || die 'path must be root owned'
}

require_release_exists() {
	validate_release_id "$1"
	local path="${MAXIEMS_RELEASES}/$1"
	[[ -d "$path" && ! -L "$path" ]] || die 'release does not exist'
	require_root_owned "$path"
}
