{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://at-energy.example/schemas/maxiems-release.v1.schema.json",
  "title": "MAXiEMS Local Release Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "version",
    "payloadSha256",
    "supportedUbuntuVersions",
    "supportedArchitectures",
    "minimumDeployerVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^[0-9]{14}-[0-9a-f]{12}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "supportedUbuntuVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "supportedArchitectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["amd64", "arm64"] }
    },
    "minimumDeployerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
