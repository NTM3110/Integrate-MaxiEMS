{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxiems.local/schemas/openems-components.v1.schema.json",
  "title": "MaxiEMS OpenEMS component manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factoryPid", "properties"],
      "properties": {
        "factoryPid": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "updateOnly": { "type": "boolean" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "updateOnly": { "const": true } }, "required": ["updateOnly"] },
          "then": { "required": ["id"] }
        }
      ]
    },
    "value": {
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        { "type": "number" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "boolean" },
              { "type": "number" }
            ]
          }
        }
      ]
    }
  }
}
