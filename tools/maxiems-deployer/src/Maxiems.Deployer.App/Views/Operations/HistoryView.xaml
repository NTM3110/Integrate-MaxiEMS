<UserControl x:Class="Maxiems.Deployer.App.Views.Operations.HistoryView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		AutomationProperties.Name="{DynamicResource History.Automation}">
	<Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<StackPanel><TextBlock Text="{DynamicResource History.Title}" Style="{DynamicResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/><TextBlock Text="{DynamicResource History.Subtitle}" Style="{DynamicResource PageSubtitle}"/><Label Target="{Binding ElementName=RunSearchBox}" Content="{DynamicResource History.Search}"/><TextBox x:Name="RunSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}"/></TextBox.InputBindings></TextBox><TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
		<DataGrid Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="{DynamicResource History.TableAutomation}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Column.Started}" Binding="{Binding StartedAt}"/><DataGridTextColumn Header="{DynamicResource Column.Serial}" Binding="{Binding Serial}"/><DataGridTextColumn Header="{DynamicResource Column.Action}" Binding="{Binding ObservedAction}"/><DataGridTextColumn Header="{DynamicResource Column.State}" Binding="{Binding FinalState}"/><DataGridTextColumn Header="{DynamicResource Column.Release}" Binding="{Binding ReleaseId}"/><DataGridTextColumn Header="{DynamicResource Column.Report}" Binding="{Binding ReportIntegrity}" Width="*"/></DataGrid.Columns></DataGrid>
	</Grid>
</UserControl>
