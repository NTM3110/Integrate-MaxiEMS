<UserControl x:Class="Maxiems.Deployer.App.Views.Operations.DevicesView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		AutomationProperties.Name="{DynamicResource Devices.Automation}">
	<Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<StackPanel><TextBlock Text="{DynamicResource Devices.Title}" Style="{DynamicResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/><TextBlock Text="{DynamicResource Devices.Subtitle}" Style="{DynamicResource PageSubtitle}"/><Label Target="{Binding ElementName=DeviceSearchBox}" Content="{DynamicResource Devices.Search}"/><TextBox x:Name="DeviceSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Devices.SearchAutomation}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}"/></TextBox.InputBindings></TextBox><TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
		<DataGrid Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="{DynamicResource Devices.TableAutomation}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Column.Serial}" Binding="{Binding Serial}"/><DataGridTextColumn Header="{DynamicResource Column.State}" Binding="{Binding State}"/><DataGridTextColumn Header="{DynamicResource Column.Profile}" Binding="{Binding Profile.ProfileId}"/><DataGridTextColumn Header="{DynamicResource Column.Updated}" Binding="{Binding UpdatedAt}" Width="*"/></DataGrid.Columns></DataGrid>
	</Grid>
</UserControl>
