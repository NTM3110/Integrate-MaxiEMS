<UserControl x:Class="Maxiems.Deployer.App.Views.Operations.ProfilesView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		AutomationProperties.Name="{DynamicResource Profiles.Automation}">
	<UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanVisibility"/></UserControl.Resources>
	<Grid Margin="30">
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<StackPanel>
			<TextBlock Text="{DynamicResource Profiles.Title}" Style="{DynamicResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
			<TextBlock Text="{DynamicResource Profiles.Subtitle}" Style="{DynamicResource PageSubtitle}"/>
			<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
				<Button Content="{DynamicResource Profiles.New}" Command="{Binding NewProfileCommand}" Style="{DynamicResource PrimaryButton}"/>
				<Button Content="{DynamicResource Profiles.NewRevision}" Command="{Binding NewRevisionCommand}" IsEnabled="{Binding HasSelectedProfile}" Margin="10,0,0,0"/>
			</StackPanel>
			<TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
		</StackPanel>

		<Grid Grid.Row="1" Margin="0,16,0,0">
			<Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
			<Border Style="{DynamicResource SurfaceCard}" Padding="8">
				<Grid>
					<ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="{DynamicResource Profiles.RevisionsAutomation}">
						<ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock><Run Text="v"/><Run Text="{Binding Reference.Version}"/><Run Text=" · "/><Run Text="{Binding State}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
					</ListBox>
					<TextBlock Text="{DynamicResource Profiles.EmptyHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14" VerticalAlignment="Center">
						<TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
					</TextBlock>
				</Grid>
			</Border>

			<Border Grid.Column="1" Style="{DynamicResource SurfaceCard}" Margin="16,0,0,0" Padding="20">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<StackPanel>
							<StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEditorVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
							<TextBlock Text="{DynamicResource Profiles.Selected}" Style="{DynamicResource SectionTitle}"/>
							<TextBlock Text="{Binding SelectedProfile.DisplayName}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"/>
							<TextBlock Text="{Binding SelectedProfile.ProductFamily}" Margin="0,5,0,0"/>
							<TextBlock Text="{Binding SelectedProfile.HardwareVariant}" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<CheckBox Content="{DynamicResource Profiles.Advanced}" IsChecked="{Binding AdvancedVisible}" Margin="0,22,0,0"/>
							<Border Margin="0,10,0,0">
								<Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AdvancedVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
								<StackPanel>
									<CheckBox Content="{DynamicResource Profiles.Immutable}" IsChecked="{Binding AdvancedConfirmed}"/>
									<Label Target="{Binding ElementName=ProfileJsonBox}" Content="{DynamicResource Profiles.Json}"/>
									<TextBox x:Name="ProfileJsonBox" Text="{Binding DraftJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="220" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Profiles.JsonAutomation}"/>
									<StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="{DynamicResource Profiles.Save}" Command="{Binding SaveDraftCommand}"/><Button Content="{DynamicResource Profiles.Approve}" Command="{Binding ApproveRevisionCommand}" Margin="8,0,0,0"/></StackPanel>
								</StackPanel>
							</Border>
						</StackPanel>

						<StackPanel Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanVisibility}}">
							<TextBlock Text="{Binding EditorHeading}" Style="{DynamicResource SectionTitle}" FontSize="20"/>
							<TextBlock Text="{DynamicResource Profiles.IdentityTitle}" Style="{DynamicResource SectionTitle}" Margin="0,18,0,6"/>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,10,0"><Label Target="{Binding ElementName=ProfileIdBox}" Content="{DynamicResource Profiles.ProfileId}"/><TextBox x:Name="ProfileIdBox" Text="{Binding ProfileId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsProfileIdEditable}"/><TextBlock Text="{DynamicResource Profiles.IdHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
								<StackPanel Grid.Column="1"><Label Target="{Binding ElementName=VersionBox}" Content="{DynamicResource Profiles.Version}"/><TextBox x:Name="VersionBox" Text="{Binding ProfileVersion, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
							</Grid>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=DisplayNameBox}" Content="{DynamicResource Profiles.DisplayName}"/><TextBox x:Name="DisplayNameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=FamilyBox}" Content="{DynamicResource Profiles.ProductFamily}"/><TextBox x:Name="FamilyBox" Text="{Binding ProductFamily, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
							</Grid>
							<Label Target="{Binding ElementName=VariantBox}" Content="{DynamicResource Profiles.HardwareVariant}"/><TextBox x:Name="VariantBox" Text="{Binding HardwareVariant, UpdateSourceTrigger=PropertyChanged}"/>
							<Label Target="{Binding ElementName=ChangeBox}" Content="{DynamicResource Profiles.ChangeNote}"/><TextBox x:Name="ChangeBox" Text="{Binding ChangeNote, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Text="{DynamicResource Profiles.HardwareTitle}" Style="{DynamicResource SectionTitle}" Margin="0,22,0,6"/>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=ArchBox}" Content="{DynamicResource Profiles.Architecture}"/><ComboBox x:Name="ArchBox" ItemsSource="{Binding Architectures}" SelectedItem="{Binding Architecture}"/></StackPanel>
								<StackPanel Grid.Column="1" Margin="8,0"><Label Target="{Binding ElementName=CpuBox}" Content="{DynamicResource Profiles.CpuModel}"/><TextBox x:Name="CpuBox" Text="{Binding CpuModel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Column="2" Margin="8,0,0,0"><Label Target="{Binding ElementName=CoreBox}" Content="{DynamicResource Profiles.MinimumCores}"/><TextBox x:Name="CoreBox" Text="{Binding MinimumLogicalCores}"/></StackPanel>
							</Grid>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=RamMinBox}" Content="{DynamicResource Profiles.MinimumRam}"/><TextBox x:Name="RamMinBox" Text="{Binding MinimumMemoryGiB}"/></StackPanel>
								<StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=RamMaxBox}" Content="{DynamicResource Profiles.MaximumRam}"/><TextBox x:Name="RamMaxBox" Text="{Binding MaximumMemoryGiB}"/></StackPanel>
							</Grid>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=StorageKindBox}" Content="{DynamicResource Profiles.StorageKind}"/><ComboBox x:Name="StorageKindBox" ItemsSource="{Binding StorageKinds}" SelectedItem="{Binding StorageKind}"/></StackPanel>
								<StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=StorageModelBox}" Content="{DynamicResource Profiles.StorageModel}"/><TextBox x:Name="StorageModelBox" Text="{Binding StorageModel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
							</Grid>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=StorageMinBox}" Content="{DynamicResource Profiles.MinimumStorage}"/><TextBox x:Name="StorageMinBox" Text="{Binding MinimumStorageGb}"/></StackPanel>
								<StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=StorageMaxBox}" Content="{DynamicResource Profiles.MaximumStorage}"/><TextBox x:Name="StorageMaxBox" Text="{Binding MaximumStorageGb}"/></StackPanel>
							</Grid>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=OsBox}" Content="{DynamicResource Profiles.OsVersion}"/><TextBox x:Name="OsBox" Text="{Binding OperatingSystemVersion, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=ImageBox}" Content="{DynamicResource Profiles.OsImage}"/><TextBox x:Name="ImageBox" Text="{Binding OperatingSystemImage, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
							</Grid>

							<TextBlock Text="{DynamicResource Profiles.NetworkTitle}" Style="{DynamicResource SectionTitle}" Margin="0,22,0,4"/>
							<TextBlock Text="{DynamicResource Profiles.NetworkHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

							<TextBlock Text="{DynamicResource Profiles.ModulesTitle}" Style="{DynamicResource SectionTitle}" Margin="0,22,0,6"/>
							<CheckBox Content="{DynamicResource Profiles.Include4G}" IsChecked="{Binding Include4G}"/>
							<Grid Visibility="{Binding Include4G, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=VendorBox}" Content="{DynamicResource Profiles.FourGVendor}"/><TextBox x:Name="VendorBox" Text="{Binding FourGVendorId}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=ProductBox}" Content="{DynamicResource Profiles.FourGProduct}"/><TextBox x:Name="ProductBox" Text="{Binding FourGProductId}"/></StackPanel></Grid>
							<CheckBox Content="{DynamicResource Profiles.IncludeLora}" IsChecked="{Binding IncludeLora}" Margin="0,12,0,0"/>
							<StackPanel Visibility="{Binding IncludeLora, Converter={StaticResource BooleanVisibility}}"><Label Target="{Binding ElementName=LoraBox}" Content="{DynamicResource Profiles.LoraNode}"/><TextBox x:Name="LoraBox" Text="{Binding LoraDeviceNode}"/></StackPanel>
							<CheckBox Content="{DynamicResource Profiles.IncludeWifiBle}" IsChecked="{Binding IncludeWifiBle}" Margin="0,12,0,0"/>
							<Grid Visibility="{Binding IncludeWifiBle, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=WifiBox}" Content="{DynamicResource Profiles.WifiDriver}"/><TextBox x:Name="WifiBox" Text="{Binding WifiDriver}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=BleBox}" Content="{DynamicResource Profiles.BleDriver}"/><TextBox x:Name="BleBox" Text="{Binding BleDriver}"/></StackPanel></Grid>

							<TextBlock Text="{DynamicResource Profiles.ReleaseTitle}" Style="{DynamicResource SectionTitle}" Margin="0,22,0,6"/>
							<Label Target="{Binding ElementName=ReleaseBox}" Content="{DynamicResource Profiles.CurrentRelease}"/><TextBox x:Name="ReleaseBox" Text="{Binding CurrentReleaseId, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"/>
							<TextBlock Text="{DynamicResource Profiles.ReleaseHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
							<StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="{DynamicResource Profiles.SaveForm}" Command="{Binding SaveFormDraftCommand}"/><Button Content="{DynamicResource Profiles.ApproveForm}" Command="{Binding ApproveFormCommand}" Style="{DynamicResource PrimaryButton}" Margin="10,0,0,0"/><Button Content="{DynamicResource Profiles.Cancel}" Command="{Binding CancelEditCommand}" Margin="10,0,0,0"/></StackPanel>
						</StackPanel>
						<TextBlock Text="{Binding EditorStatus}" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive"/>
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</UserControl>
