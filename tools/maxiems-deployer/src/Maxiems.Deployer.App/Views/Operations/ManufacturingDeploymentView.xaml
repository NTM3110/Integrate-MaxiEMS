<UserControl x:Class="Maxiems.Deployer.App.Views.Operations.ManufacturingDeploymentView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		AutomationProperties.Name="{DynamicResource Deploy.Automation}"
		Background="{DynamicResource CanvasBrush}">
	<UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanVisibility"/></UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="30" MaxWidth="980" HorizontalAlignment="Left">
			<Grid>
				<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="{DynamicResource Deploy.Title}" Style="{DynamicResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
					<TextBlock Text="{DynamicResource Deploy.Subtitle}" Style="{DynamicResource PageSubtitle}" TextWrapping="Wrap"/>
				</StackPanel>
				<Border Grid.Column="1" Background="{DynamicResource BrandBlueTintBrush}" CornerRadius="14" Padding="14,7" VerticalAlignment="Top">
					<TextBlock Text="{Binding StepSummary}" Foreground="{DynamicResource BrandBlueBrush}" FontWeight="SemiBold"/>
				</Border>
			</Grid>

			<Border Background="{DynamicResource BrandBlueTintBrush}" BorderBrush="{DynamicResource BrandBlueBrush}" BorderThickness="1" Padding="14" CornerRadius="8" Margin="0,0,0,14">
				<StackPanel>
					<TextBlock Text="{DynamicResource Deploy.CurrentStatus}" Foreground="{DynamicResource BrandBlueBrush}" FontSize="11" FontWeight="Bold"/>
					<TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrandBlueBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Assertive"/>
				</StackPanel>
			</Border>

			<Border Style="{DynamicResource SurfaceCard}" Padding="20" Margin="0,0,0,14">
				<StackPanel>
					<TextBlock Text="{DynamicResource Deploy.Step1}" Style="{DynamicResource SectionTitle}"/>
					<Label Target="{Binding ElementName=ProfileBox}" Content="{DynamicResource Deploy.Profile}"/>
					<ComboBox x:Name="ProfileBox" ItemsSource="{Binding ApprovedProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{DynamicResource Deploy.ProfileAutomation}"/>
					<TextBlock Text="{DynamicResource Deploy.NoProfiles}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
						<TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasApprovedProfiles}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
					</TextBlock>
				</StackPanel>
			</Border>

			<Border Style="{DynamicResource SurfaceCard}" Padding="20" Margin="0,0,0,14" IsEnabled="{Binding HasApprovedProfiles}">
				<StackPanel>
					<TextBlock Text="{DynamicResource Deploy.Step2}" Style="{DynamicResource SectionTitle}"/>
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
						<StackPanel Margin="0,0,10,0"><Label Target="{Binding ElementName=HostBox}" Content="{DynamicResource Deploy.Host}"/><TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Deploy.HostAutomation}"/></StackPanel>
						<StackPanel Grid.Column="1" Margin="0,0,10,0"><Label Target="{Binding ElementName=PortBox}" Content="{DynamicResource Deploy.Port}"/><TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Deploy.PortAutomation}"/></StackPanel>
						<StackPanel Grid.Column="2"><Label Target="{Binding ElementName=UserBox}" Content="{DynamicResource Deploy.Username}"/><TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Deploy.UsernameAutomation}"/></StackPanel>
					</Grid>
					<Button Content="{DynamicResource Deploy.Verify}" Click="EvaluateTrust_Click" Margin="0,14,0,0" HorizontalAlignment="Left" Style="{DynamicResource PrimaryButton}"/>
					<Border Background="{DynamicResource WarningTintBrush}" Padding="12" CornerRadius="7" Margin="0,12,0,0" Visibility="{Binding HasTrustDecision, Converter={StaticResource BooleanVisibility}}">
						<StackPanel>
							<TextBlock Text="{Binding TrustDecision.ObservedFingerprint.Sha256Value}" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource Deploy.FingerprintAutomation}"/>
							<CheckBox Content="{DynamicResource Deploy.FingerprintConfirm}" IsChecked="{Binding TrustRiskAcknowledged}" Margin="0,10,0,0"/>
							<Button Content="{DynamicResource Deploy.ConfirmFingerprint}" Click="ConfirmTrust_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>

			<Border Style="{DynamicResource SurfaceCard}" Padding="20" Margin="0,0,0,14" Visibility="{Binding TrustConfirmed, Converter={StaticResource BooleanVisibility}}">
				<StackPanel>
					<TextBlock Text="{DynamicResource Deploy.Step3}" Style="{DynamicResource SectionTitle}"/>
					<TextBlock Text="{DynamicResource Deploy.PasswordHelp}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
					<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
						<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=BootstrapPasswordBox}" Content="{DynamicResource Deploy.SshPassword}"/><PasswordBox x:Name="BootstrapPasswordBox" AutomationProperties.Name="{DynamicResource Deploy.SshPasswordAutomation}"/></StackPanel>
						<StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=AdministratorPasswordBox}" Content="{DynamicResource Deploy.AdminPassword}"/><PasswordBox x:Name="AdministratorPasswordBox" AutomationProperties.Name="{DynamicResource Deploy.AdminPasswordAutomation}"/></StackPanel>
					</Grid>
					<StackPanel Orientation="Horizontal" Margin="0,14,0,0">
						<Button Content="{DynamicResource Deploy.Inspect}" Click="Inspect_Click" IsEnabled="{Binding CanInspect}" HorizontalAlignment="Left" Style="{DynamicResource PrimaryButton}"/>
						<Button Content="{DynamicResource Deploy.Cancel}" Click="Cancel_Click" IsEnabled="{Binding CanCancelCurrentOperation}" Margin="10,0,0,0"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border x:Name="LanMappingCard" Style="{DynamicResource SurfaceCard}" Padding="20" Margin="0,0,0,14" Visibility="{Binding HasInspection, Converter={StaticResource BooleanVisibility}}">
				<StackPanel>
					<TextBlock Text="{DynamicResource Deploy.Step4}" Style="{DynamicResource SectionTitle}"/>
					<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
						<StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=Wan0Box}" Content="{DynamicResource Deploy.Lan1}"/><ComboBox x:Name="Wan0Box" ItemsSource="{Binding AvailableInterfaces}" SelectedItem="{Binding SerialSourceLinuxName}" AutomationProperties.Name="{DynamicResource Deploy.Lan1Automation}"/><TextBlock Text="{Binding SerialSourceSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
						<StackPanel Grid.Column="1" Margin="8,0,0,0"><Label Target="{Binding ElementName=Wan1Box}" Content="{DynamicResource Deploy.Lan2}"/><ComboBox x:Name="Wan1Box" ItemsSource="{Binding AvailableInterfaces}" SelectedItem="{Binding SecondaryLinuxName}" AutomationProperties.Name="{DynamicResource Deploy.Lan2Automation}"/><TextBlock Text="{Binding SecondarySummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
					</Grid>
					<TextBlock Text="{Binding SerialPreview}" Foreground="{DynamicResource BrandBlueBrush}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
					<Button Content="{DynamicResource Deploy.ConfirmMapping}" Click="ConfirmMapping_Click" IsEnabled="{Binding CanConfirmMapping}" Margin="0,14,0,0" HorizontalAlignment="Left" Style="{DynamicResource PrimaryButton}"/>
				</StackPanel>
			</Border>

			<Border Style="{DynamicResource SurfaceCard}" Padding="20" Margin="0,0,0,14" Visibility="{Binding HasReview, Converter={StaticResource BooleanVisibility}}">
				<StackPanel>
					<TextBlock Text="{DynamicResource Deploy.Step5}" Style="{DynamicResource SectionTitle}"/>
					<UniformGrid Columns="3" Margin="0,10,0,10">
						<Border Style="{DynamicResource MetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource Deploy.Serial}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DerivedSerial}" FontWeight="SemiBold"/></StackPanel></Border>
						<Border Style="{DynamicResource MetricCard}" Margin="4,0"><StackPanel><TextBlock Text="{DynamicResource Deploy.Action}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ActionSummary}" FontWeight="SemiBold"/></StackPanel></Border>
						<Border Style="{DynamicResource MetricCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Deploy.Release}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ReleaseSummary}" FontWeight="SemiBold"/></StackPanel></Border>
					</UniformGrid>
					<DataGrid ItemsSource="{Binding Checklist}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260" AutomationProperties.Name="{DynamicResource Deploy.ChecklistAutomation}">
						<DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Column.Check}" Binding="{Binding Code}"/><DataGridTextColumn Header="{DynamicResource Column.Result}" Binding="{Binding Outcome}"/><DataGridTextColumn Header="{DynamicResource Column.Observed}" Binding="{Binding Observed}" Width="*"/><DataGridTextColumn Header="{DynamicResource Column.Expected}" Binding="{Binding Expected}" Width="*"/></DataGrid.Columns>
					</DataGrid>
					<ItemsControl ItemsSource="{Binding BlockingReasons}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
					<StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="{DynamicResource Deploy.Deploy}" Click="Deploy_Click" IsEnabled="{Binding CanDeploy}" Style="{DynamicResource PrimaryButton}"/><Button Content="{DynamicResource Deploy.Cancel}" Click="Cancel_Click" IsEnabled="{Binding CanCancelCurrentOperation}" Margin="10,0,0,0"/><Button Content="{DynamicResource Deploy.Reset}" Command="{Binding ResetCommand}" Margin="10,0,0,0"/></StackPanel>
				</StackPanel>
			</Border>

			<DataGrid ItemsSource="{Binding Progress}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" Margin="0,0,0,14" Visibility="{Binding HasProgress, Converter={StaticResource BooleanVisibility}}">
				<DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Column.Phase}" Binding="{Binding Phase}"/><DataGridTextColumn Header="{DynamicResource Column.Status}" Binding="{Binding Outcome}"/><DataGridTextColumn Header="{DynamicResource Column.Details}" Binding="{Binding OperatorMessage}" Width="*"/></DataGrid.Columns>
			</DataGrid>
		</StackPanel>
	</ScrollViewer>
</UserControl>
