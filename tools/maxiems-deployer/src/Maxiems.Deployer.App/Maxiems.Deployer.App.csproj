<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Maxiems.Deployer.App</RootNamespace>
    <AssemblyName>Maxiems.Deployer</AssemblyName>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>../../icon/Favicon_AT Energy.ico</ApplicationIcon>
	<ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Maxiems.Deployer.Core/Maxiems.Deployer.Core.csproj" />
    <ProjectReference Include="../Maxiems.Deployer.Infrastructure/Maxiems.Deployer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="../../icon/MAXiCom Logo.png" Link="Assets/MAXiComLogo.png" />
    <Resource Include="../../icon/Favicon_AT Energy.png" Link="Assets/AtEnergyFavicon.png" />
    <EmbeddedResource Include="../../fixtures/openems-components.modbus-readonly.v1.json"
                      LogicalName="Maxiems.Deployer.Profiles.ModbusReadOnly.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(MaxiemsPayloadPath)' != '' and Exists('$(MaxiemsPayloadPath)')">
    <EmbeddedResource Include="$(MaxiemsPayloadPath)" LogicalName="Maxiems.Deployer.Payload.zip" />
  </ItemGroup>
</Project>
