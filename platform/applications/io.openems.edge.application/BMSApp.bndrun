-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-21
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active

# Dedicated BMS development runtime. Keep it separate from EdgeApp and its
# operational config/data directory; see apps/bms/README.md before starting.
-runproperties: \
	org.osgi.service.http.port=8080,\
	org.apache.felix.http.host=0.0.0.0,\
	felix.cm.dir=config-bms,\
	openems.data.dir=data-bms,\
	org.apache.felix.eventadmin.Timeout=0,\
	org.ops4j.pax.logging.DefaultServiceLog.level=WARN

-runsystempackages: \
	sun.misc,\
	com.sun.net.httpserver

-runblacklist: \
	bnd.identity;id='org.osgi.service.cm',\
	bnd.identity;id='io.openems.edge.smartlogger.huawei'

-runbundles+: \
	org.apache.felix.scr;startlevel=10,\
	org.apache.felix.configadmin;startlevel=11,\
	org.apache.felix.eventadmin;startlevel=12,\
	org.apache.felix.fileinstall;startlevel=13,\
	org.ops4j.pax.logging.pax-logging-api;startlevel=14,\
	org.ops4j.pax.logging.pax-logging-log4j2;startlevel=15,\
	io.openems.core.logger;startlevel=16,\
	io.openems.edge.application;startlevel=17

-runrequires: \
	bnd.identity;id='org.ops4j.pax.logging.pax-logging-api',\
	bnd.identity;id='org.ops4j.pax.logging.pax-logging-log4j2',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.apache.felix.http.servlet-api',\
	bnd.identity;id='org.apache.felix.webconsole',\
	bnd.identity;id='org.apache.felix.webconsole.plugins.ds',\
	bnd.identity;id='org.apache.felix.inventory',\
	bnd.identity;id='org.apache.felix.eventadmin',\
	bnd.identity;id='org.apache.felix.fileinstall',\
	bnd.identity;id='io.openems.core.logger',\
	bnd.identity;id='io.openems.common',\
	bnd.identity;id='io.openems.edge.common',\
	bnd.identity;id='io.openems.edge.application',\
	bnd.identity;id='io.openems.edge.core',\
	bnd.identity;id='io.openems.edge.bridge.modbus',\
	bnd.identity;id='io.openems.edge.bms.bridge.modbus',\
	bnd.identity;id='io.openems.edge.controller.api.websocket',\
	bnd.identity;id='io.openems.edge.controller.api.rest',\
	bnd.identity;id='io.openems.edge.scheduler.allalphabetically',\
	bnd.identity;id='io.openems.edge.bms.huasu.ta',\
	bnd.identity;id='io.openems.edge.bms.huasu.tc',\
	bnd.identity;id='io.openems.edge.bms.service',\
	bnd.identity;id='io.openems.edge.shared.postgresql',\
	bnd.identity;id='io.openems.edge.controller.bms',\
	bnd.identity;id='io.openems.edge.bms.api',\
	bnd.identity;id='io.openems.edge.modem.4g'
-runbundles: \
	com.fasterxml.aalto-xml;version='[1.3.4,1.3.5)',\
	com.fazecast.jSerialComm;version='[2.11.4,2.11.5)',\
	com.google.gson;version='[2.13.2,2.13.3)',\
	com.google.guava;version='[33.5.0,33.5.1)',\
