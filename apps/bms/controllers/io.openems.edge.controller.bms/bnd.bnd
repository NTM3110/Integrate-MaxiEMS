Bundle-Name: OpenEMS Edge BMS Controller
Bundle-Vendor: FENECON GmbH
Bundle-License: https://opensource.org/licenses/EPL-2.0
Bundle-Version: 1.0.0.${tstamp}

-buildpath: \
	${buildpath},\
	io.openems.common,\
	io.openems.edge.common,\
	io.openems.edge.bridge.modbus,\
	io.openems.edge.controller.api,\
	io.openems.edge.bms.service,\
	io.openems.edge.bms.huasu.tc,\
	io.openems.edge.bms.huasu.ta,\
	io.openems.j2mod,\

-testpath: \
	${testpath}

Export-Package: \
	io.openems.edge.bms.controllers.calculation,\
	io.openems.edge.bms.controllers.calculation.checkpoint,\
	io.openems.edge.bms.controllers.calculation.estimator

Private-Package: \
	io.openems.edge.bms.controllers.calculation.legacy,\
	io.openems.edge.bms.controllers.monitoring,\
	io.openems.edge.bms.controllers.modbus
